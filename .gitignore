/mcp-server/
/slack-cli/env
/systemd/user/mcp-server.service.d/
.env
.env.*
!.env.example
!.env.*.example
*.key
*.pem

# Application sessions, history, and telemetry.
/fish/fish_variables
/go/telemetry/
